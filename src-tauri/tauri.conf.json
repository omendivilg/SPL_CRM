{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SPL Control Financiero",
  "version": "0.3.4",
  "identifier": "mx.spl.control-financiero",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "SPL",
    "copyright": "Copyright 2026 SPL",
    "category": "Finance",
    "shortDescription": "Control de eventos, finanzas y nómina de SPL",
    "externalBin": ["binaries/spl-node"],
    "resources": {
      "../dist/": "frontend/",
      "../desktop-backend-dist/": "backend/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
